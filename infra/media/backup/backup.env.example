# /opt/vocably-media/backup.env (chmod 600). Read by the `backup` service in ../docker-compose.yml.

# The bot that posts into the backup channel (it must be an admin of the channel: post, delete and pin messages).
TELEGRAM_BOT_TOKEN=
# The private backup channel, e.g. -1001234567890.
BACKUP_CHAT_ID=
# 64 hex characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# KEEP A COPY OFF THIS SERVER: without it the channel content cannot be decrypted.
BACKUP_KEY=

# Garage key of the media bucket (Key ID / Secret key from key.txt).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional: where problems and the daily one-line report go (the admin's chat with the bot).
ALERT_CHAT_ID=
# Optional tuning: SCAN_INTERVAL_SEC=60  SEND_PAUSE_MS=3100  RETENTION_DAYS=30  REPORT_HOUR_UTC=4
