metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
metadata_auto_snapshot_interval = "6h"
replication_factor = 1
compression_level = 1
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "CHANGE_ME"  # openssl rand -hex 32 (rpc) / -base64 32 (tokens)
[s3_api]
s3_region = "us-east-1"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"
[admin]
api_bind_addr = "[::]:3903"
admin_token = "CHANGE_ME"  # openssl rand -hex 32 (rpc) / -base64 32 (tokens)
metrics_token = "CHANGE_ME"  # openssl rand -hex 32 (rpc) / -base64 32 (tokens)
