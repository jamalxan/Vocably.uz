# realtime-server .env (VPS'da: chmod 600 .env). docker-compose.yml ikkala xizmatga ham env_file sifatida beradi.
PORT=4001
NODE_ENV=production
# Next.js ilovadagi REALTIME_SHARED_SECRET bilan bir xil bo'lishi SHART (socket tiketlari,
# qo'ng'iroq grant'lari va ichki so'rovlar shu sir bilan imzolanadi/tekshiriladi).
REALTIME_SHARED_SECRET=
# Next.js ilovaning manzili — "onlayn bo'ldi" Telegram bildirishnomasi
# (/api/internal/presence-online) va qo'ng'iroq tarixi (/api/internal/call-event) uchun.
# Bo'sh qoldirilsa ikkalasi ham o'chiq (qo'ng'iroqlar ishlaydi, lekin tarixga yozilmaydi).
NEXTJS_INTERNAL_URL=https://vocably.uz
# Production'da MAJBURIY (bo'sh bo'lsa server ishga tushmaydi).
REALTIME_ALLOWED_ORIGINS=https://vocably.uz,https://www.vocably.uz
# coturn static-auth-secret — Next.js (Vercel) dagi TURN_SECRET bilan bir xil. Faqat coturn o'qiydi.
TURN_SECRET=
# Qo'ng'iroq taymerlari (ms): jiringlash, ulanish, qayta ulanish (grace).
CALL_RING_TIMEOUT_MS=45000
CALL_CONNECT_TIMEOUT_MS=30000
CALL_GRACE_MS=15000
