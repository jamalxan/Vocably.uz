# MongoDB Atlas ulanish manzili (README'da qanday olish yozilgan)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sinonimlar?retryWrites=true&w=majority

# Ixtiyoriy uzun, tasodifiy maxfiy kalit (masalan: openssl rand -hex 32)
JWT_SECRET=super_secret_key_shu_yerga_ozgartiring

# Google AI Studio'dan olinadigan Gemini API kaliti
GEMINI_API_KEY=AIzaSy...

# --- Telegram orqali telefon raqamni tasdiqlash uchun ---

# @BotFather'dan olingan bot tokeni (masalan: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# Bot username'i, @ belgisisiz (masalan: VocablyBot)
TELEGRAM_BOT_USERNAME=

# Webhook so'rovlarini tekshirish uchun ixtiyoriy tasodifiy maxfiy matn (masalan: openssl rand -hex 20)
TELEGRAM_WEBHOOK_SECRET=

# /api/telegram/setup endpointini himoyalash uchun maxfiy kalit (masalan: openssl rand -hex 20)
ADMIN_SETUP_SECRET=

# Sayt joylashgan to'liq manzil, webhookni sozlashda ishlatiladi (masalan: https://loyiha-nomi.vercel.app)
APP_URL=
