# MongoDB Atlas ulanish manzili (README'da qanday olish yozilgan)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sinonimlar?retryWrites=true&w=majority

# Ixtiyoriy uzun, tasodifiy maxfiy kalit (masalan: openssl rand -hex 32)
JWT_SECRET=super_secret_key_shu_yerga_ozgartiring

# Google AI Studio'dan olinadigan Gemini API kaliti (AI chat uchun oxirgi zaxira provayder)
GEMINI_API_KEY=AIzaSy...

# Groq API kaliti (console.groq.com) — matnli AI chat uchun asosiy provayder, bepul tarifda RPM yuqori
GROQ_API_KEY=gsk_...

# OpenRouter API kaliti (openrouter.ai) — rasmli xabarlar va matnli zaxira uchun
OPENROUTER_API_KEY=sk-or-v1-...

# --- Telegram orqali telefon raqamni tasdiqlash uchun ---

# @BotFather'dan olingan bot tokeni (masalan: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TELEGRAM_BOT_TOKEN=

# Bot username'i, @ belgisisiz (masalan: VocablyBot)
TELEGRAM_BOT_USERNAME=

# Webhook so'rovlarini tekshirish uchun ixtiyoriy tasodifiy maxfiy matn (masalan: openssl rand -hex 20)
TELEGRAM_WEBHOOK_SECRET=

# /api/telegram/setup endpointini himoyalash uchun maxfiy kalit (masalan: openssl rand -hex 20)
ADMIN_SETUP_SECRET=

# Bitta admin'ning Telegram chat ID'si — shu chatdan botga /users yoki /stats yozilsa,
# foydalanuvchilar soni va ro'yxati (ism, telefon, ro'yxatdan o'tgan sana) qaytariladi.
# O'z chat ID'ingizni bilish uchun botga istalgan xabar yozib, keyin @userinfobot'dan foydalaning.
TELEGRAM_ADMIN_CHAT_ID=

# Sayt joylashgan to'liq manzil, webhookni sozlashda ishlatiladi (masalan: https://loyiha-nomi.vercel.app)
APP_URL=

# --- Do'stlar bo'limi (foydalanuvchilararo chat) uchun ---
# docs/ chat plani: media MinIO'da (S3-mos), jonli xabar/onlayn holat alohida
# realtime-server/ xizmatida — ikkalasi ham 3.238.62.211 serverda.

# MinIO endpoint (masalan: https://media.vocably.uz), bucket va IAM-uslubidagi kalitlar.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=vocably-chat-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# realtime-server/ xizmatining ichki manzili (masalan: https://realtime.vocably.uz) va
# ikkala tomonda bir xil bo'lishi shart bo'lgan maxfiy kalit (masalan: openssl rand -hex 20).
REALTIME_INTERNAL_URL=
REALTIME_SHARED_SECRET=

# Brauzerga (client) yuboriladigan, socket.io-client shu manzilga ulanadi — yuqoridagi
# REALTIME_INTERNAL_URL bilan bir xil qiymat, lekin NEXT_PUBLIC_ prefiksi bilan.
NEXT_PUBLIC_REALTIME_URL=

# --- Brauzer push bildirishnomalari (Web Push API) uchun ---
# `npx web-push generate-vapid-keys` bilan generatsiya qilinadi (bir marta, keyin
# barcha muhitlarda bir xil juftlik ishlatiladi — kalit almashsa eski obunalar buziladi).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push xizmatlari (brauzerlar) ba'zan shu manzilga muammo yuzasidan murojaat qiladi.
VAPID_SUBJECT=mailto:admin@vocably.uz

# Brauzerga (client) yuboriladigan — yuqoridagi VAPID_PUBLIC_KEY bilan bir xil qiymat,
# lekin NEXT_PUBLIC_ prefiksi bilan (client PushManager.subscribe() shu kalitni ishlatadi).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
